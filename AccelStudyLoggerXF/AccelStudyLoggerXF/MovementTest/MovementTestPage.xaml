<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AccelStudyLoggerXF.MovementTest.MovementTestPage"
             Title="Movement Test (Live)">
    <ScrollView>
        <StackLayout Padding="16" Spacing="10">
            <Entry x:Name="MacFilterEntry" Placeholder="Tag MAC filter (optional)" />

            <Label Text="Detector Tuning (runtime only)" FontAttributes="Bold" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" VerticalTextAlignment="Center" Text="Target Window (sec)" />
                <Entry x:Name="TargetWindowEntry" Grid.Row="0" Grid.Column="1" Keyboard="Numeric" />

                <Label Grid.Row="1" Grid.Column="0" VerticalTextAlignment="Center" Text="Max Window (sec)" />
                <Entry x:Name="MaxWindowEntry" Grid.Row="1" Grid.Column="1" Keyboard="Numeric" />

                <Button x:Name="ApplyTuningBtn" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Apply" Clicked="ApplyTuning_Clicked" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartScanBtn" Text="Start Scan" Clicked="StartScan_Clicked" Grid.Column="0" />
                <Button x:Name="StopScanBtn" Text="Stop Scan" Clicked="StopScan_Clicked" Grid.Column="1" IsEnabled="False" />
            </Grid>

            <Label Text="Live Status" FontAttributes="Bold" />
            <Label x:Name="ModeLabel" Text="Mode: Idle" />
            <Label x:Name="TagLabel" Text="Tag: - | RSSI: -" />
            <Label x:Name="MagnitudeLabel" Text="aMag: - | baseline: - | delta: -" />
            <Label x:Name="MetricsLabel" Text="peak: - | activeMs: - | motion: -" />
            <Label x:Name="PersistenceEnergyLabel" Text="persistence: - | energy: - | orientShift: -" />
            <Label x:Name="PacketLabel" Text="last packet: -" />

            <Label Text="Final Result" FontAttributes="Bold" />
            <Frame x:Name="ResultFrame" Padding="12" CornerRadius="6" BackgroundColor="#E6E6E6">
                <StackLayout>
                    <Label x:Name="ResultBanner" Text="No detection result yet" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="ResultDetails" Text="-" FontSize="Small" />
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>
</ContentPage>
